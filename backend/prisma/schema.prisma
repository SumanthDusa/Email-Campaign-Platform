generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  firstName    String?
  lastName     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  passwordHash String        @map("password_hash")
  role         UserRole      @default(CAMPAIGN_MANAGER)
  name         String
  campaigns    Campaign[]
  contactLists ContactList[]
  contacts     Contact[]
  templates    Template[]

  @@map("users")
}

model Contact {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @db.Uuid
  email       String
  firstName   String?
  lastName    String?
  unsubscribed Boolean @default(false)
  
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  phone       String?
  source      String?
  status      String?
  listMembers ContactListMember[]
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailEvents EmailEvent[]
  emailOpens  EmailOpen[]
  @@unique([userId, email])
  @@index([userId])
  @@map("contacts")
}

model EmailOpen {
  id          String   @id @default(uuid()) @db.Uuid
  contactId   String   @db.Uuid
  campaignId  String   @db.Uuid
  openedAt    DateTime @default(now())

  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([campaignId])

  @@map("email_opens")
}

model ContactList {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @db.Uuid
  name        String
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  campaigns   Campaign[]
  members     ContactListMember[]
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("contact_lists")
}

model ContactListMember {
  contactId String      @db.Uuid
  createdAt DateTime    @default(now())
  listId    String      @db.Uuid
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([contactId, listId])
  @@index([listId])
  @@map("contact_list_members")
}

model Template {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  name    String
  subject String
  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("templates")
}

model Campaign {
  id            String  @id @default(uuid()) @db.Uuid
  userId        String  @db.Uuid
  contactListId String  @db.Uuid
  templateId    String? @db.Uuid

  name    String
  subject String

  content String?

  status CampaignStatus @default(draft)

  scheduledAt DateTime?
  sentAt      DateTime?

  emailsSent Int @default(0)
  opens      Int @default(0)
  clicks     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contactList ContactList @relation(fields: [contactListId], references: [id])

  template Template? @relation(fields: [templateId], references: [id])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailEvents EmailEvent[]
  emailOpens  EmailOpen[]

  @@index([userId])
  @@index([contactListId])
  @@index([templateId])
  @@map("campaigns")
}

model EmailEvent {
  id         String         @id @default(uuid()) @db.Uuid
  campaignId String         @db.Uuid
  contactId  String         @db.Uuid
  eventType  EmailEventType
  eventAt    DateTime       @default(now())
  messageId  String?
  linkUrl    String?
  metadata   Json?
  campaign   Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact    Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([contactId])
  @@index([eventType])
  @@map("email_events")
}

enum Role {
  SUPER_ADMIN
  MANAGER
  VIEWER
}

enum CampaignStatus {
  draft
  scheduled
  sending
  paused
  completed
  cancelled
}

enum EmailEventType {
  queued
  delivered
  open
  click
  bounce
  complaint
  unsubscribe
}

enum UserRole {
  SUPER_ADMIN
  CAMPAIGN_MANAGER
  CLIENT_SUBSCRIBER
}
